# ── Summarization ───────────────────────────────────────────────
# Primary provider: GitHub Copilot chat completions (OpenAI-compatible).
# Uses your logged-in GitHub OAuth token (gh auth token output) or a PAT
# tied to a Copilot subscription. Does NOT need a separate paid API key.
# COPILOT_API_TOKEN=gho_xxxxxxxxxxxxxxxxxxxx
# Comma-separated model chain tried in order; first success wins.
# Choose models that support /chat/completions on Copilot, e.g.:
#   claude-sonnet-5.5, claude-haiku-5.5, gpt-4.1, gpt-4o-mini
#   (GPT-5.x "GA models" return unsupported_api_for_model; they sit behind
#    Copilot's /responses-style endpoint, not chat/completions)
# COPILOT_MODEL=claude-sonnet-5.5,claude-haiku-5.5,gpt-4o-mini
# Per-request timeout in ms.
# COPILOT_REQUEST_TIMEOUT_MS=120000

# ── Gemini (summarization fallback) ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Primary model, with a comma-separated fallback chain used on 404/429/5xx.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-fast,gemini-3-flash,gemini-3.0-flash,gemini-3.0-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-1.5-flash
# Delay between videos (ms) to stay under Gemini's free-tier rate limits.
GEMINI_VIDEO_DELAY_MS=7000

# ── Notion integration (optional) ───────────────────────────────
# NOTION_TOKEN=secret_...
# NOTION_PAGE_ID=your-page-id-here
